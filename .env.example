# IIUC Live Campus Map - environment template (do not commit real .env)
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
APP_NAME=IIUC Live Campus Map
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/app.db
SESSION_DB_PATH=./data/sessions.db
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:3000

# Base map tiles (see docs/MAP_TILES.md)
# osm-standard (default) or osm-de. Only add providers whose usage policy allows
# this application's interactive, low-volume use.
TILE_PROVIDER=osm-standard
# Only consecutive tile errors before the page stops requesting tiles and shows
# the local offline grid. A manual "Retry tiles" action is required to resume.
TILE_ERROR_THRESHOLD=6
# Advanced: JSON object/array of extra or overriding providers.
# TILE_PROVIDERS_JSON={"osm-de":{"urlTemplate":"https://tile.openstreetmap.de/{z}/{x}/{y}.png","attribution":"&copy; OpenStreetMap contributors","maxZoom":19}}
# Override the selected provider without redefining it.
# TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# TILE_MIN_ZOOM=0
# TILE_MAX_ZOOM=19
ADMIN_BOOTSTRAP_EMAIL=admin@iiuc.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
REGISTRATION_ENABLED=1
